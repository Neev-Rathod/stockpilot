# ─── Supabase (required) ─────────────────────────────────────────────────────
# From your Supabase project → Project Settings → API.
# Use the BASE project URL (https://<ref>.supabase.co) — NOT the /rest/v1/ endpoint.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Secret — used ONLY by scripts/import-csv-to-supabase.mjs. Never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# ─── Finnhub (optional but recommended) ──────────────────────────────────────
# Powers news, SEC filings, earnings, company profiles, and symbol search.
# The app boots without it, but those features return empty.
# Free key: https://finnhub.io/register
FINNHUB_API_KEY=your-finnhub-key
